<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NetOcc.Vtk from netocc-vtk's pack output, NetOcc from netocc-core's, the rest from nuget.org -->
  <packageSources>
    <clear />
    <add key="netocc-vtk" value="../../netocc-vtk/artifacts/packages" />
    <add key="netocc-core" value="../../netocc-core/artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
