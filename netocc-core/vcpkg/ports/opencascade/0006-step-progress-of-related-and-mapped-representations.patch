-      aBinder = TransferEntity(aMDADR, theTP, theLocalFactors, thePS.Next());
+      aBinder = TransferEntity(aMDADR, theTP, theLocalFactors, aRange);
     }
     else if (theReadConstructiveGeomRR
              && anItem->DynamicType()
