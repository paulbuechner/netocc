        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetOcc.Vtk.Viewer"
        Title="NetOcc.Vtk Viewer (WPF)" Width="1100" Height="750">
