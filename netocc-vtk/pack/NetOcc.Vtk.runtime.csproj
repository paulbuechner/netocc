<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NetOcc.Vtk.runtime.<rid>: NetOccVtk and OCCT's TKIVtk for one RID (artifacts/runtimes/<rid>/native, from build.py
    native) with their license notices. build.py pack packs it once per RID (-p:NetOccVtkRid=<rid>); the NetOcc.Vtk package
    depends on all of them. OCCT's other libraries come with NetOcc.runtime, VTK's with NetVtk.runtime.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NetOccVtkRid Condition="'$(NetOccVtkRid)' == ''">win-x64</NetOccVtkRid>
    <PackageId>NetOcc.Vtk.runtime.$(NetOccVtkRid)</PackageId>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <Authors>Paul Büchner</Authors>
    <Copyright>Copyright (c) 2026 Paul Büchner</Copyright>
    <Description>Native libraries of NetOcc.Vtk for $(NetOccVtkRid): NetOccVtk and OCCT 8.0.1's TKIVtk. Referenced by the NetOcc.Vtk package; not meant to be installed alone.</Description>
    <PackageTags>occt;opencascade;vtk;native</PackageTags>
    <PackageProjectUrl>https://paulbuechner.github.io/netocc/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/paulbuechner/netocc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>THIRD-PARTY-NOTICES.txt</PackageLicenseFile>
    <!-- natives only: no assembly, no dependencies (NU5128: lib/ placeholders without dependency groups) -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NetOccVtkStage>$(MSBuildThisFileDirectory)..\artifacts\runtimes\$(NetOccVtkRid)</NetOccVtkStage>
  </PropertyGroup>

  <!-- PackagePath with forward slashes: CI packs on Linux, where a trailing backslash gives entries like native//libX.so -->
  <ItemGroup>
    <None Include="$(NetOccVtkStage)\native\*" Pack="true" PackagePath="runtimes/$(NetOccVtkRid)/native/" Visible="false" />
    <None Include="$(NetOccVtkStage)\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(NetOccVtkStage)\sbom.cdx.json" Pack="true" PackagePath="sbom/" Visible="false" />
    <!-- empty lib/ placeholders: compatible with .NET Framework 3.5+ and netstandard2.0 consumers (.NET 6+ included) -->
    <None Include="_._" Pack="true" PackagePath="lib/net35/;lib/netstandard2.0/" Visible="false" />
    <!-- which natives an app gets (NetOcc.Vtk.runtime.targets): its architecture's in x64\ or x86\ on .NET Framework, which
         ignores runtimes/, and what they load of NetOcc's and NetVtk's when those select modules; net35 for .NET
         Framework, netstandard2.0 for .NET -->
    <None Include="NetOcc.Vtk.runtime.targets" Pack="true" Visible="false"
          PackagePath="build/net35/$(PackageId).targets;buildTransitive/net35/$(PackageId).targets;build/netstandard2.0/$(PackageId).targets;buildTransitive/netstandard2.0/$(PackageId).targets" />
    <None Include="$(NetOccVtkStage)\natives.targets" Pack="true" Visible="false"
          PackagePath="build/net35/$(PackageId).natives.targets;buildTransitive/net35/$(PackageId).natives.targets;build/netstandard2.0/$(PackageId).natives.targets;buildTransitive/netstandard2.0/$(PackageId).natives.targets" />
  </ItemGroup>

  <Target Name="NetOccVtkCheckStage" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NetOccVtkStage)\native')" Text="No natives in $(NetOccVtkStage)\native: run build.py native for $(NetOccVtkRid) first." />
    <Error Condition="!Exists('$(NetOccVtkStage)\sbom.cdx.json')" Text="No SBOM in $(NetOccVtkStage): run build.py native for $(NetOccVtkRid) again." />
    <Error Condition="!Exists('$(NetOccVtkStage)\natives.targets')" Text="No natives.targets in $(NetOccVtkStage): pack through build.py pack." />
  </Target>

</Project>
