<Project>

  <!--
    The NetVtk release NetOcc.Vtk builds on: its proxies and VTK's libraries (NetVtk.runtime). The same VTK build as
    netocc-core's (opencascade[vtk] from NetVtk's vcpkg registry: vcpkg-configuration.json's baseline, vcpkg.json's vtk
    override with its port-version): change all three together. local-dev.props takes a local pack's version instead (Directory.Build.props).
  -->
  <PropertyGroup>
    <NetVtkVersion Condition="'$(NetVtkVersion)' == ''">9.7.1.1-next.4</NetVtkVersion>
  </PropertyGroup>

</Project>
