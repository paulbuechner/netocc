<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NetOcc.Vtk from the local pack output, NetOcc from netocc-core's, the rest from nuget.org (NetVtk: build.py's source) -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="netocc-core" value="../../../netocc-core/artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
