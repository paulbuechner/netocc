<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net48</TargetFrameworks>
    <!-- test on the installed runtimes: the arch option of dotnet test sets a RID (NETSDK1201 before net8.0) -->
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NetOcc.Vtk.Tests</RootNamespace>
    <NetOccArtifacts>$(MSBuildThisFileDirectory)..\..\..\netocc-core\artifacts\runtimes</NetOccArtifacts>
    <NetOccVtkArtifacts>$(MSBuildThisFileDirectory)..\..\artifacts\runtimes</NetOccVtkArtifacts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetOcc.Vtk\NetOcc.Vtk.csproj" />
  </ItemGroup>

  <!--
    AnyCPU layout, as netocc-core's tests: NetOcc's natives and NetOcc.Vtk's in x64\ and x86\; VTK's come with the NetVtk
    package (runtimes\<rid>\native, x64\ and x86\ on .NET Framework)
  -->
  <ItemGroup>
    <None Include="$(NetOccArtifacts)\win-x64\native\*;$(NetOccVtkArtifacts)\win-x64\native\*" Link="x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NetOccArtifacts)\win-x86\native\*;$(NetOccVtkArtifacts)\win-x86\native\*" Link="x86\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NetOccArtifacts)\linux-x64\native\*;$(NetOccVtkArtifacts)\linux-x64\native\*" Link="runtimes\linux-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NetOccArtifacts)\osx-arm64\native\*;$(NetOccVtkArtifacts)\osx-arm64\native\*" Link="runtimes\osx-arm64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
